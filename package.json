{
  "name": "apple-music-library-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "favourite": "tsx --env-file-if-exists=.env src/favourite.ts",
    "format": "prettier '**/*.{ts,js,mjs,md,json}' --write",
    "format:check": "prettier '**/*.{ts,js,mjs,md,json}' --check",
    "lint": "eslint '**/*.ts' --fix",
    "lint:check": "eslint '**/*.ts' --max-warnings=0",
    "lint-staged": "lint-staged",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.ts": "eslint --fix",
    "*.{ts,js,mjs,md,json}": "prettier --write"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.8.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "packageManager": "pnpm@12.18.0"
}
